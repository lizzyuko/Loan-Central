# ---------------------------------------------------------------------------
# Loan Central environment variables
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# Public base URL (used in emails, magic links, metadata). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Neon) --------------------------------------------------------
# Use the *pooled* connection string (host contains "-pooler") for the app.
DATABASE_URL=
# Optional: direct (non-pooled) URL used by migrations. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# --- Security ---------------------------------------------------------------
# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=
# Exactly 32 bytes, base64. Encrypts account details at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Bearer secret Vercel Cron sends to /api/cron/cleanup.
CRON_SECRET=

# First super admin, created on deploy by the seed step. The password is only
# applied if that admin has no password yet (it never overwrites one changed
# in the app). 12+ characters. You can delete these after the first deploy.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=

# --- Email -------------------------------------------------------------------
# Email providers (Resend and/or Zoho Mail) are configured in the admin
# dashboard: Settings → Email. These Resend variables are an OPTIONAL fallback
# used only when no provider is configured there.
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "Loan Central <noreply@yourdomain.com>"
RESEND_FROM_EMAIL=
# Optional reply-to address for applicant emails.
RESEND_REPLY_TO=

# --- Documents (Cloudinary) -------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Bot protection (Cloudflare Turnstile) ----------------------------------
# Cloudflare test keys (always pass) for local development:
#   site:   1x00000000000000000000AA
#   secret: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Development only -------------------------------------------------------
# When "true" AND NODE_ENV=development AND RESEND_API_KEY is empty, emails are
# printed to the server console instead of sent (e.g. invite/reset links,
# portal sign-in codes). Ignored in production.
DEV_EMAIL_CONSOLE=false
